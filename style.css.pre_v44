:root {
  --cream: #f7f1ea;
  --cream-2: #efe4d9;
  --paper: #fcfaf7;
  --ink: #211d1b;
  --muted: #746b64;
  --line: rgba(33, 29, 27, .14);
  --rose: #c88986;
  --rose-soft: #e7c7c0;
  --gold: #b79763;
  --blue-deep: #003E6A;
  --blue: #0392B2;
  --blue-2: #00529D;
  --radius: 26px;
  --shadow: 0 25px 70px rgba(57, 38, 25, .10);
  --serif: "Cormorant Garamond", Georgia, serif;
  --sans: "Inter", Arial, sans-serif;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; background: var(--cream); color: var(--ink); font-family: var(--sans); line-height: 1.6; }
body::selection { background: var(--blue-deep); color: #fff; }
a { color: inherit; text-decoration: none; }
img { display: block; width: 100%; object-fit: cover; }
button { font: inherit; }

.page-shell { overflow: hidden; }
.site-header { position: sticky; top: 0; z-index: 50; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 28px; min-height: 82px; padding: 12px clamp(22px, 4vw, 64px); background: rgba(247,241,234,.94); backdrop-filter: blur(18px); border-bottom: 1px solid rgba(183,151,99,.18); }
.header-mark { justify-self: start; display: inline-flex; align-items: center; justify-content: center; width: 46px; height: 46px; }
.header-mark img { width: 42px; height: 26px; object-fit: contain; display: block; }
.header-wordmark { justify-self: center; display: inline-flex; align-items: center; justify-content: center; min-width: 0; line-height: 1; }
.header-wordmark img { display: block; width: 154px; height: auto; }
.header-name { font-family: var(--serif); font-size: 24px; font-weight: 500; letter-spacing: -.02em; color: var(--gold); white-space: nowrap; }
.header-beauty { display: grid; grid-template-columns: 28px auto 28px; align-items: center; width: 100%; gap: 8px; color: var(--gold); }
.header-beauty i { height: 1px; background: currentColor; opacity: .72; }
.header-beauty b { font-family: var(--sans); font-size: 7px; font-weight: 500; text-transform: uppercase; letter-spacing: .34em; margin-left: .34em; }
.header-actions { justify-self: end; display: flex; align-items: center; gap: clamp(16px, 2.2vw, 30px); }
.desktop-nav { display: flex; align-items: center; justify-content: center; gap: clamp(16px, 2vw, 28px); font-size: 10px; text-transform: uppercase; letter-spacing: .11em; }
.desktop-nav a, .footer-links a { position: relative; }
.desktop-nav a::after, .footer-links a::after { content: ""; position: absolute; left: 0; right: 0; bottom: -5px; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: right; transition: transform .25s ease; }
.desktop-nav a:hover::after, .footer-links a:hover::after { transform: scaleX(1); transform-origin: left; }
.header-cta { display: inline-flex; align-items: center; justify-content: center; padding: 10px 16px; border-radius: 999px; background: var(--blue-deep); color: #fff; font-size: 10px; text-transform: uppercase; letter-spacing: .12em; }
.menu-toggle { display: none; justify-self: end; border: 0; background: transparent; width: 40px; height: 40px; padding: 8px; cursor: pointer; }
.menu-toggle span { display: block; height: 1px; background: var(--ink); margin: 7px 0; transition: transform .2s ease; }
.mobile-nav { display: none; }


.hero { min-height: calc(100svh - 82px); display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); align-items: center; gap: clamp(35px, 6vw, 90px); padding: clamp(46px, 7vw, 92px) clamp(22px, 6vw, 90px); }
.hero-copy { position: relative; padding: 20px 0; max-width: 680px; }
.hero-monogram { position: absolute; top: -10px; right: 2%; width: 116px; height: auto; opacity: .085; transform: rotate(-8deg); pointer-events: none; user-select: none; }
.hero-topline { display: flex; align-items: center; justify-content: space-between; gap: 18px; width: 100%; }
.eyebrow { display: inline-flex; align-items: center; gap: 10px; font-size: 10px; font-weight: 600; letter-spacing: .19em; text-transform: uppercase; color: var(--blue-deep); }
.eyebrow i { display: inline-block; width: 26px; height: 1px; background: currentColor; }
.hero-instagram { width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; color: var(--gold); border: 1px solid rgba(166,126,61,.38); border-radius: 50%; background: rgba(255,255,255,.2); transition: background .25s ease, border-color .25s ease, transform .25s ease; }
.hero-instagram svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.45; }
.hero-instagram:hover { background: rgba(183,151,99,.12); border-color: rgba(166,126,61,.65); transform: translateY(-1px); }
.hero-kicker { display: flex; align-items: center; gap: 10px; margin: 30px 0 7px; font-size: 10px; font-weight: 700; letter-spacing: .25em; color: var(--muted); }
.hero-kicker::after { content: ""; width: 42px; height: 1px; background: var(--gold); opacity: .6; }
h1, h2, h3 { margin: 0; font-weight: 600; }
h1, h2, h3, .brand-name, .quote-card p { font-family: var(--serif); }
h1 { max-width: 650px; font-size: clamp(55px, 6.3vw, 100px); line-height: .91; letter-spacing: -.035em; }
h1 em, h2 em { color: var(--blue-deep); font-weight: 500; }
.hero h1 em { color: var(--gold); }
.hero-text { max-width: 530px; margin: 25px 0 0; color: var(--muted); font-size: 15px; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 50px; padding: 0 20px; border: 1px solid transparent; border-radius: 999px; text-transform: uppercase; letter-spacing: .13em; font-size: 10px; font-weight: 700; transition: transform .2s ease, background .2s ease, color .2s ease; }
.btn:hover { transform: translateY(-2px); }
.btn-primary { background: var(--blue-deep); color: #fff; }
.btn-primary:hover { background: var(--blue-2); }
.btn-ghost { border-color: rgba(33,29,27,.22); background: transparent; }
.btn-ghost:hover { background: rgba(255,255,255,.58); }
.btn-dark { background: var(--ink); color: #fff; }
.btn-light { background: #fff; color: var(--blue-deep); }
.dark-outline { border-color: rgba(255,255,255,.25); color: #fff; }
.location-pill { display: inline-flex; align-items: center; gap: 10px; margin-top: 42px; padding-top: 16px; border-top: 1px solid var(--line); min-width: 220px; }
.location-icon { width: 30px; height: 30px; border: 1px solid var(--gold); border-radius: 50%; display: grid; place-items: center; color: var(--gold); }
.location-pill strong, .location-pill small { display: block; }
.location-pill strong { font-size: 12px; letter-spacing: .06em; }
.location-pill small { color: var(--muted); font-size: 10px; }

.hero-visual { position: relative; min-height: 640px; }
.hero-frame { position: absolute; overflow: hidden; border-radius: 260px 260px 24px 24px; box-shadow: var(--shadow); }
.hero-frame-main { inset: 0 12% 0 6%; }
.hero-frame-main img { height: 100%; }
.hero-frame-detail { width: 34%; height: 42%; right: 0; bottom: -4%; border-radius: 22px; border: 8px solid var(--cream); box-shadow: 0 20px 50px rgba(26,18,12,.16); transform: rotate(3deg); }
.hero-frame-detail img { height: 100%; }
.hero-accent { position: absolute; top: 4%; right: 0; font-family: var(--serif); font-size: 19px; line-height: .76; color: var(--gold); text-align: right; letter-spacing: .07em; }
.hero-accent span { font-family: var(--sans); font-size: 8px; letter-spacing: .4em; }
.vertical-note { position: absolute; left: -36px; bottom: 92px; transform: rotate(-90deg); transform-origin: left bottom; font-size: 8px; letter-spacing: .31em; color: var(--muted); }


.trust-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  align-items: stretch;
  padding: 0;
  background: var(--blue-deep);
  color: #fff;
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: .13em;
}

.trust-strip a {
  min-height: 64px;
  display: grid;
  place-items: center;
  padding: 12px 14px;
  color: inherit;
  text-align: center;
  text-decoration: none;
  line-height: 1.35;
  border-left: 1px solid rgba(183,151,99,.24);
  transition: background .25s ease;
}

.trust-strip a:first-child { border-left: 0; }
.trust-strip a:hover { background: rgba(183,151,99,.055); }
.section { padding: clamp(85px, 10vw, 140px) clamp(22px, 6vw, 90px); }
.section-label { font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
.services .section-label { display: inline-flex; align-items: center; gap: 10px; color: var(--gold); font-size: 9px; letter-spacing: .19em; }
.services .section-label::before { content: ""; width: 24px; height: 1px; background: var(--gold); opacity: .58; }
.about-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .85fr); gap: clamp(45px, 8vw, 130px); align-items: center; margin-top: 42px; }
.about-image-wrap { position: relative; max-width: 680px; }
.about-image-wrap img { aspect-ratio: 1 / 1.14; border-radius: 34px; }
.image-stamp { position: absolute; right: -32px; bottom: 36px; display: grid; place-items: center; width: 118px; height: 118px; padding: 14px; border-radius: 50%; background: var(--blue-deep); color: #fff; font-size: 8px; line-height: 1.15; letter-spacing: .17em; text-align: center; }
.image-stamp em { color: #bfeaf3; font-family: var(--serif); font-size: 20px; line-height: .3; }
.about-copy h2, .section-heading h2, .feedback h2, .location h2, .instagram h2, .feature-copy h2, .lips-copy h2, .training-copy h2 { margin-top: 22px; font-size: clamp(48px, 6vw, 82px); line-height: .93; letter-spacing: -.04em; }
.about-copy p, .feature-copy p, .lips-copy p, .training-copy p, .feedback .muted, .location-copy p { color: var(--muted); font-size: 15px; }
.about-copy p { max-width: 560px; }
.about-signature { margin-top: 38px; font-family: var(--serif); font-size: 34px; }
.about-signature span { display: block; font-family: var(--sans); font-size: 9px; letter-spacing: .18em; color: var(--muted); text-transform: uppercase; margin-top: 3px; }

.section-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 30px; }
.section-heading > p { max-width: 430px; color: var(--muted); font-size: 14px; }
.section-heading.compact { align-items: center; }
.service-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 38px; }
.service-card { background: var(--paper); border: 1px solid rgba(33,29,27,.08); border-radius: 26px; overflow: hidden; min-height: 610px; display: flex; flex-direction: column; transition: transform .3s ease, box-shadow .3s ease; }
.service-card:hover { transform: translateY(-7px); box-shadow: var(--shadow); }
.service-image { height: 270px; overflow: hidden; }
.service-image img { height: 100%; transition: transform .5s ease; }
.service-card:hover .service-image img { transform: scale(1.04); }
.service-content { display: flex; flex: 1; flex-direction: column; padding: 26px; }
.service-index { display: none; }
.service-content h3 { margin-top: 0; font-size: 37px; line-height: .91; }
.service-content h3::before { content: ""; display: block; width: 24px; height: 1px; margin-bottom: 16px; background: var(--gold); opacity: .65; }
.service-content p { margin: 18px 0 25px; color: var(--muted); font-size: 13px; }
.service-content a { margin-top: auto; display: flex; justify-content: space-between; align-items: center; padding-top: 18px; border-top: 1px solid var(--line); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; }
.service-cta-icon { width: 18px; height: 18px; flex: 0 0 18px; color: var(--gold); display: block; }
.service-cta-icon path { fill: currentColor; }
.service-card-course .service-cta-icon { color: #bfeaf3; }
.service-card-course { background: var(--blue-deep); color: #fff; }
.service-card-course .service-content p { color: rgba(255,255,255,.68); }
.service-card-course .service-index { color: #bfeaf3; }
.service-card-course .service-content a { border-color: rgba(255,255,255,.22); }


/* Lash feature: editorial eyebrow sits above the image */
.feature-lash {
  grid-template-rows: auto 1fr;
}
.feature-lash .feature-eyebrow-top {
  grid-column: 1;
  grid-row: 1;
  align-self: end;
  margin-bottom: 14px;
}
.feature-lash .feature-image {
  grid-column: 1;
  grid-row: 2;
}
.feature-lash .feature-copy {
  grid-column: 2;
  grid-row: 1 / 3;
  align-self: center;
}
@media (max-width: 820px) {
  .feature-lash {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .feature-lash .feature-eyebrow-top {
    order: 0;
    align-self: flex-start;
    margin-bottom: 14px;
  }
  .feature-lash .feature-image {
    order: 1;
  }
  .feature-lash .feature-copy {
    order: 2;
  }
}
.feature { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(40px, 7vw, 105px); align-items: center; padding: 0 clamp(22px, 6vw, 90px) clamp(80px, 10vw, 140px); }
.feature.reverse { grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); }
.feature.reverse .feature-image { order: 2; }
.feature.reverse .feature-copy { order: 1; }
.feature-image { overflow: hidden; }
.feature-image img { aspect-ratio: 1.2 / 1; border-radius: 34px; }
.feature-copy { max-width: 620px; }
.feature-tags, .feature-mini-grid { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 28px; }
.feature-tags span { padding: 8px 12px; border: 1px solid var(--line); border-radius: 999px; font-size: 9px; text-transform: uppercase; letter-spacing: .1em; }
.feature-techniques { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 9px; margin-top: 28px; }
.technique-card { position: relative; min-height: 88px; padding: 16px 14px 13px; border: 1px solid rgba(183,151,99,.26); border-radius: 16px; background: rgba(255,255,255,.26); display: flex; flex-direction: column; justify-content: flex-end; transition: transform .2s ease, border-color .2s ease, background .2s ease; }
.technique-card:hover { transform: translateY(-2px); border-color: rgba(183,151,99,.52); background: rgba(255,255,255,.45); }
.technique-line { position: absolute; top: 12px; left: 14px; width: 20px; height: 1px; background: var(--gold); opacity: .7; }
.technique-card strong { font-size: 11px; font-weight: 500; letter-spacing: .05em; color: var(--ink); text-transform: uppercase; }
.technique-card small { margin-top: 4px; color: var(--muted); font-size: 9.5px; line-height: 1.35; }
.btn-whatsapp-icon { width: 16px; height: 16px; fill: currentColor; display: block; flex: 0 0 16px; }
.text-link-icon { width: 17px; height: 17px; fill: currentColor; display: block; flex: 0 0 17px; }
.text-link-icon.instagram-icon { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.6; }

.feature-mini-grid span { min-width: 120px; padding-top: 12px; border-top: 1px solid var(--line); font-size: 9px; letter-spacing: .08em; color: var(--muted); }
.feature-mini-grid b { color: var(--ink); font-size: 13px; font-weight: 600; }
.text-link { display: inline-flex; align-items: center; gap: 10px; margin-top: 30px; padding-bottom: 7px; border-bottom: 1px solid currentColor; font-size: 10px; text-transform: uppercase; letter-spacing: .12em; font-weight: 700; }

.lips-section { background: var(--rose-soft); }
.lips-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(35px, 7vw, 100px); align-items: center; margin-top: 35px; }
.lips-image img { aspect-ratio: 1.45 / 1; border-radius: 34px; }
.lips-copy { max-width: 570px; }

.training { background: var(--blue-deep); color: #fff; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(50px, 8vw, 120px); align-items: center; }
.training .section-label, .training .eyebrow { color: #bfeaf3; }
.training-art { position: relative; min-height: 620px; display: flex; align-items: center; justify-content: center; border-radius: 36px; background: radial-gradient(circle at 35% 30%, rgba(3,146,178,.38), transparent 25%), radial-gradient(circle at 80% 80%, rgba(183,151,99,.24), transparent 24%), #012f50; overflow: hidden; }
.training-number { position: absolute; top: 18px; left: 25px; font-family: var(--serif); font-size: 94px; color: rgba(255,255,255,.08); }
.training-word { position: absolute; right: 22px; bottom: 18px; font-size: 8px; letter-spacing: .34em; writing-mode: vertical-rl; color: rgba(255,255,255,.46); }
.training-card { width: 60%; min-height: 300px; padding: 32px; border-radius: 260px 260px 24px 24px; background: linear-gradient(180deg, #e8d5c4, #b98678); color: var(--ink); display: flex; flex-direction: column; justify-content: flex-end; box-shadow: 0 35px 70px rgba(0,0,0,.18); }
.training-card span { text-transform: uppercase; letter-spacing: .2em; font-size: 8px; }
.training-card strong { margin-top: 10px; font-family: var(--serif); font-size: 46px; line-height: .85; }
.training-card small { margin-top: 16px; font-size: 9px; text-transform: uppercase; letter-spacing: .16em; }
.training-copy h2 { color: #fff; }
.training-copy h2 em { color: #bfeaf3; }
.training-copy p { color: rgba(255,255,255,.68); max-width: 570px; }
.training-points { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 34px 0; }
.training-points span { padding-top: 12px; border-top: 1px solid rgba(255,255,255,.18); font-size: 10px; text-transform: uppercase; letter-spacing: .1em; color: rgba(255,255,255,.65); }
.training-points b { display: block; margin-bottom: 4px; color: #bfeaf3; font-size: 9px; }
.note { display: block; margin-top: 18px; color: rgba(255,255,255,.43); font-size: 10px; }

.results-grid { display: grid; grid-template-columns: 1.1fr .9fr .9fr; grid-template-rows: 260px 260px; gap: 12px; margin-top: 45px; }
.result { margin: 0; overflow: hidden; border-radius: 22px; background: var(--paper); }
.result img { width: 100%; height: 100%; transition: transform .45s ease; }
.result:hover img { transform: scale(1.03); }
.result-large { grid-row: span 2; }
.result-wide { grid-column: span 2; }

.feedback { background: var(--paper); }
.feedback-layout { display: grid; grid-template-columns: 1fr .75fr; gap: clamp(40px, 8vw, 130px); align-items: center; margin-top: 30px; }
.quote-card { padding: 48px; border: 1px solid var(--line); border-radius: 28px; background: var(--cream); }
.quote-mark { display: block; font-family: var(--serif); font-size: 80px; line-height: .5; color: var(--gold); }
.quote-card p { margin: 35px 0 28px; font-size: 34px; line-height: .98; }
.quote-card footer { color: var(--muted); font-size: 9px; letter-spacing: .12em; text-transform: uppercase; }

.location-card { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--line); border-radius: 30px; overflow: hidden; background: var(--paper); }
.location-map-placeholder { position: relative; min-height: 430px; display: grid; place-items: center; background: repeating-linear-gradient(135deg, #e8ded4 0, #e8ded4 2px, #efe7df 2px, #efe7df 24px); }
.location-map-placeholder span { font-size: 10px; letter-spacing: .3em; color: var(--muted); }
.map-pin { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 72px; height: 72px; display: grid; place-items: center; border-radius: 50%; background: var(--blue-deep); color: #fff; font-size: 28px; box-shadow: 0 12px 30px rgba(0,62,106,.23); }
.location-copy { padding: clamp(35px, 5vw, 70px); display: flex; flex-direction: column; justify-content: center; }
.location-placeholder { margin-top: 28px; padding: 16px 0; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 3px; }
.location-placeholder strong { font-size: 13px; }
.location-placeholder span { font-size: 10px; color: var(--muted); }

.instagram { position: relative; overflow: hidden; background: var(--rose-soft); }
.instagram-mark { position: absolute; top: 34px; right: 18px; width: 110px; opacity: .055; transform: rotate(8deg); pointer-events: none; }
.instagram-head { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: flex-end; gap: 30px; }
.ig-handle { display: inline-flex; align-items: center; gap: 11px; padding: 12px 18px; border: 1px solid rgba(255,255,255,.55); border-radius: 999px; color: #fff; background: rgba(255,255,255,.07); font-size: 11px; font-weight: 600; letter-spacing: .025em; text-transform: none; transition: transform .2s ease, background .2s ease, border-color .2s ease; }
.ig-handle:hover { transform: translateY(-2px); background: rgba(255,255,255,.15); border-color: rgba(255,255,255,.75); }
.instagram-icon { width: 18px; height: 18px; flex: 0 0 18px; fill: none; stroke: currentColor; stroke-width: 1.55; }
.ig-grid { display: grid; grid-template-columns: 1.15fr .85fr .85fr; grid-template-rows: 220px 220px; gap: 12px; margin-top: 35px; }
.ig-card, .ig-follow-card { position: relative; overflow: hidden; border-radius: 22px; }
.ig-card { display: block; min-width: 0; background: rgba(255,255,255,.18); }
.ig-card-featured { grid-row: 1 / span 2; }
.ig-card:nth-child(4) { grid-column: 3; grid-row: 2; }
.ig-card img { width: 100%; height: 100%; transition: transform .45s ease; }
.ig-card:hover img { transform: scale(1.035); }
.ig-card span { position: absolute; left: 14px; bottom: 14px; padding: 7px 10px; border-radius: 999px; background: rgba(247,241,234,.9); color: var(--ink); font-size: 8px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
.ig-follow-card { display: flex; flex-direction: column; justify-content: flex-end; gap: 7px; padding: 22px; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.46); color: var(--ink); }
.ig-follow-card .instagram-icon { width: 26px; height: 26px; margin-bottom: auto; color: var(--gold); }
.ig-follow-card strong { max-width: 140px; font-family: var(--serif); font-size: 28px; line-height: .95; font-weight: 500; }
.ig-follow-card span { font-size: 9px; letter-spacing: .12em; text-transform: uppercase; color: rgba(33,29,27,.62); }
.ig-follow-card:hover { background: rgba(255,255,255,.24); }

.final-cta { position: relative; margin: 0 clamp(0px, 3vw, 35px); padding: clamp(65px, 8vw, 100px); display: grid; grid-template-columns: 1fr 210px; gap: 40px; align-items: end; background: var(--blue-deep); color: #fff; border-radius: 42px 42px 0 0; }
.eyebrow-light { color: #bfeaf3; }
.final-copy h2 { margin: 20px 0 15px; font-family: var(--serif); font-size: clamp(52px, 6.5vw, 92px); line-height: .9; letter-spacing: -.04em; }
.final-copy h2 em { color: #bfeaf3; }
.final-copy p { max-width: 500px; margin: 0 0 28px; color: rgba(255,255,255,.67); }
.final-side { font-family: var(--serif); font-size: 45px; line-height: .75; text-align: right; color: rgba(255,255,255,.18); }
.final-side span { font-family: var(--sans); font-size: 12px; letter-spacing: .34em; }

.final-cta::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: -30px;
  height: 36px;
  background: linear-gradient(180deg, var(--rose-soft) 0%, rgba(219, 185, 176, .72) 34%, var(--blue-deep) 100%);
  border-radius: 42px 42px 0 0;
  pointer-events: none;
}


.site-footer { display: grid; grid-template-columns: repeat(3, 1fr); align-items: center; justify-items: center; gap: 30px; padding: 28px clamp(22px, 6vw, 90px); background: #0c2637; color: #fff; }
.site-footer strong, .site-footer span { display: block; }
.site-footer strong { font-family: var(--serif); font-size: 24px; }
.site-footer span { color: rgba(255,255,255,.45); font-size: 8px; text-transform: uppercase; letter-spacing: .2em; }
.footer-links { display: flex; justify-content: center; flex-wrap: wrap; gap: 24px; font-size: 10px; text-transform: uppercase; letter-spacing: .12em; }
.site-footer small { justify-self: center; text-align: center; color: rgba(255,255,255,.45); font-size: 9px; }
.floating-whatsapp { position: fixed; z-index: 60; right: 20px; bottom: 20px; width: 52px; height: 52px; display: grid; place-items: center; border-radius: 50%; background: #16a34a; color: #fff; box-shadow: 0 12px 30px rgba(0,0,0,.2); }
.floating-whatsapp svg { width: 27px; height: 27px; fill: currentColor; display: block; }

.reveal { opacity: 0; transform: translateY(26px); transition: opacity .7s ease, transform .7s ease; }
.reveal.is-visible { opacity: 1; transform: translateY(0); }

@media (max-width: 1120px) {
  .desktop-nav { gap: 18px; font-size: 10px; }
  .hero { grid-template-columns: .9fr 1fr; }
  .hero-visual { min-height: 560px; }
  .service-grid { grid-template-columns: repeat(2, 1fr); }
  .service-card { min-height: 560px; }
  .service-image { height: 300px; }
}

@media (max-width: 820px) {
  .site-header { grid-template-columns: 1fr auto 1fr; }
  .brand { grid-column: 2; justify-self: center; }
  .desktop-nav, .header-cta { display: none; }
  .menu-toggle { grid-column: 3; display: block; justify-self: end; }
  .mobile-nav { position: fixed; z-index: 45; top: 81px; left: 0; right: 0; display: flex; flex-direction: column; gap: 0; padding: 14px 22px 24px; background: rgba(247,241,234,.98); border-bottom: 1px solid var(--line); transform: translateY(-140%); transition: transform .3s ease; }
  .mobile-nav.open { transform: translateY(0); }
  .mobile-nav a { padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 11px; text-transform: uppercase; letter-spacing: .12em; }
  .mobile-nav-cta { color: var(--blue-deep); font-weight: 700; }
  .hero { grid-template-columns: 1fr; min-height: auto; padding-top: 65px; }
  .hero-visual { min-height: 72svh; margin-top: 5px; }
  .hero-frame-main { inset: 0 9% 0 0; }
  .hero-frame-detail { right: 0; bottom: -3%; width: 39%; height: 37%; }
  .vertical-note { display: none; }
  .about-grid, .lips-grid, .feedback-layout, .location-card, .training, .feature, .feature.reverse { grid-template-columns: 1fr; }
  .feature.reverse .feature-image, .feature.reverse .feature-copy { order: initial; }
  .service-grid { grid-template-columns: 1fr; }
  .service-card { min-height: auto; }
  .service-image { height: 340px; }
  .training-art { min-height: 480px; }
  .results-grid { grid-template-columns: 1fr 1fr; grid-template-rows: 300px 220px 220px; }
  .result-large { grid-row: span 2; }
  .result-wide { grid-column: span 2; }
  .ig-grid { grid-template-columns: repeat(2, 1fr); }
  .final-cta { grid-template-columns: 1fr; }
  .final-side { display: none; }
  .site-footer { grid-template-columns: 1fr; gap: 18px; }
  .site-footer small { justify-self: center; text-align: center; }
}

@media (max-width: 560px) {
  .trust-strip {
    row-gap: 8px;
    padding: 3px 12px;
  }

  .trust-strip > span {
    padding: 1px 10px;
    font-size: 9px;
    letter-spacing: .13em;
  }

  .trust-strip > span + span::before {
    height: 11px;
  }

  .trust-strip > span:first-child::before,
  .trust-strip > span:last-child::after {
    width: 11px;
  }

  .site-header { padding: 17px 18px; }
  .hero-monogram { top: -7px; right: 0; width: 78px; opacity: .075; }
  .brand-name { font-size: 24px; }
  .hero { padding: 8px 18px 70px; }
  .hero-topline { gap: 10px; }
  .hero-instagram { width: 45px; height: 45px; font-size: 7px; letter-spacing: .1em; gap: 5px; }
  .hero-instagram svg { width: 27px; height: 40px; }
  h1 { font-size: clamp(48px, 14vw, 70px); }
  .hero-text { font-size: 14px; }
  .hero-visual { min-height: 500px; }
  .hero-frame-main { inset: 0 4% 0 0; border-radius: 170px 170px 22px 22px; }
  .hero-frame-detail { width: 42%; height: 36%; }
  .section { padding: 78px 18px; }
  .section-heading, .section-heading.compact, .instagram-head { flex-direction: column; align-items: flex-start; }
  .about-image-wrap img { border-radius: 24px; }
  .image-stamp { right: 10px; bottom: 12px; width: 92px; height: 92px; }
  .services .section-heading h2 { margin-top: 8px; }
  .services .section-heading > p { margin-top: 10px; }
  .service-grid { margin-top: 20px; gap: 14px; }
  .service-image { height: 300px; }
  .service-content h3 { font-size: 42px; }
  .service-content h3::before { width: 22px; margin-bottom: 14px; }
  .service-cta-icon { width: 18px; height: 18px; flex-basis: 18px; }
  .feature { padding-left: 18px; padding-right: 18px; }
  .feature-techniques { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: 24px; }
  .technique-card { min-height: 82px; padding: 15px 12px 12px; }
  .technique-card strong { font-size: 10.5px; font-weight: 500; }
  .technique-card small { font-size: 9px; }
  .feature-image img, .lips-image img, .location-card { border-radius: 24px; }
  .training { padding: 78px 18px; }
  .training-card { width: 75%; }
  .training-points { grid-template-columns: 1fr; }
  .results-grid { grid-template-columns: 1fr; grid-template-rows: repeat(4, 260px); }
  .result-large, .result-wide { grid-row: auto; grid-column: auto; }
  .quote-card { padding: 32px; }
  .quote-card p { font-size: 31px; }
  .location-map-placeholder { min-height: 300px; }
  .final-cta { margin: 0 0 0; border-radius: 32px 32px 0 0; padding: 65px 22px 75px; }
.final-cta::before { top: -24px; height: 30px; border-radius: 32px 32px 0 0; }
  .final-copy h2 { font-size: 58px; }
  .site-footer { padding: 28px 18px; justify-items: center; text-align: center; }
}

@media (max-width: 820px) {
  .instagram-mark { top: 24px; right: -4px; width: 86px; }
  .ig-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(3, 172px); gap: 10px; margin-top: 28px; }
  .ig-card-featured { grid-row: auto; }
.ig-card:nth-child(4) { grid-column: auto; grid-row: auto; }
  .ig-follow-card { min-height: 172px; padding: 18px; }
  .ig-follow-card strong { font-size: 24px; }
}

@media (max-width: 560px) {
  .instagram-head { gap: 18px; }
  .ig-handle { align-self: flex-start; width: auto; max-width: 100%; justify-content: center; padding: 10px 15px; font-size: 11px; font-weight: 600; letter-spacing: .035em; color: var(--ink); background: rgba(255,255,255,.18); border-color: rgba(255,255,255,.72); }
  .ig-handle .instagram-icon { width: 18px; height: 18px; flex-basis: 18px; color: var(--gold); }
  .ig-grid { grid-template-rows: repeat(2, minmax(150px, 42vw)); margin-bottom: 0; }
  .instagram { padding-bottom: 56px; }
  .ig-follow-card strong { font-size: 23px; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
}

/* V8 — header com monograma à esquerda, wordmark central e ações à direita */
@media (max-width: 900px) {
  .site-header {
    grid-template-columns: 1fr auto 1fr;
    min-height: 78px;
    padding: 10px 16px;
    gap: 12px;
    border-bottom-color: rgba(166, 126, 61, .18);
    background: rgba(247, 241, 234, .96);
  }

  .header-mark {
    grid-column: 1;
    justify-self: start;
    width: 54px;
    height: 48px;
  }

  .header-mark img {
    width: 50px;
    height: 32px;
  }

  .header-wordmark {
    grid-column: 2;
    justify-self: center;
    width: 154px;
    max-width: none;
    transform: translateY(1px);
  }

  .header-wordmark img { width: 154px; height: auto; }

  .header-actions {
    grid-column: 3;
    justify-self: end;
    display: block;
  }

  .desktop-nav, .header-cta { display: none; }

  .menu-toggle {
    width: 38px;
    height: 38px;
    padding: 9px;
    border: 1px solid rgba(166, 126, 61, .48);
    border-radius: 50%;
    background: rgba(255,255,255,.16);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
  }

  .menu-toggle span {
    width: 100%;
    height: 1px;
    margin: 0;
    background: var(--ink);
  }

  .menu-toggle[aria-expanded="true"] span:first-child {
    transform: translateY(6px) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded="true"] span:last-child {
    transform: translateY(-6px) rotate(-45deg);
  }

  .mobile-nav { top: 78px; }
}

@media (max-width: 430px) {
  .hero-topline { gap: 8px; }
  .hero-instagram { width: 45px; height: 45px; }
  .hero-instagram svg { width: 27px; height: 40px; }
  .header-wordmark, .header-wordmark img { width: 146px; }
  .header-mark { width: 48px; }
  .header-mark img { width: 46px; height: 30px; }
}
@media (max-width: 820px) {
  .trust-strip {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .trust-strip a {
    min-height: 54px;
    padding: 10px 9px;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: .09em;
    border-left-color: rgba(183,151,99,.22);
    border-top: 1px solid rgba(183,151,99,.22);
  }

  .trust-strip a:nth-child(odd) { border-left: 0; }
  .trust-strip a:nth-child(-n+2) { border-top: 0; }
}

@media (max-width: 560px) {
  .trust-strip a { min-height: 54px; padding: 10px 7px; font-size: 10px; }
}


/* V28 — correção da composição do bloco de extensão de cílios em telas estreitas */
@media (max-width: 1024px) {
  .feature-lash {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto auto auto;
    gap: 0;
    align-items: start;
  }

  .feature-lash .feature-eyebrow-top {
    grid-column: 1;
    grid-row: 1;
    align-self: start;
    justify-self: start;
    margin: 0 0 14px;
  }

  .feature-lash .feature-image {
    grid-column: 1;
    grid-row: 2;
    width: 100%;
    margin: 0 0 28px;
  }

  .feature-lash .feature-copy {
    grid-column: 1;
    grid-row: 3;
    width: 100%;
    max-width: none;
    align-self: start;
  }

  .feature-lash .feature-image img {
    width: 100%;
    display: block;
  }
}


/* V31 — maquiagem: identificação acima da imagem + etapas em grade leve */
.feature-makeup {
  grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
  grid-template-rows: auto 1fr;
  align-items: start;
}
.feature-makeup .feature-eyebrow-top {
  grid-column: 1;
  grid-row: 1;
  align-self: start;
  justify-self: start;
  margin: 0 0 22px;
}
.feature-makeup .feature-image {
  grid-column: 2;
  grid-row: 1 / span 2;
  order: initial;
}
.feature-makeup .feature-copy {
  grid-column: 1;
  grid-row: 2;
  align-self: center;
  order: initial;
}
.feature-makeup .feature-mini-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0;
  margin-top: 26px;
  border-top: 1px solid rgba(183,151,99,.24);
  border-bottom: 1px solid rgba(183,151,99,.18);
}
.feature-makeup .feature-mini-grid span {
  min-width: 0;
  padding: 14px 10px 13px;
  border-top: 0;
  border-left: 1px solid rgba(183,151,99,.18);
  text-align: center;
  font-size: 10px;
  letter-spacing: .06em;
  color: var(--ink);
}
.feature-makeup .feature-mini-grid span:first-child { border-left: 0; }
.feature-makeup .feature-mini-grid b {
  font-size: 11px;
  font-weight: 500;
  letter-spacing: .05em;
  text-transform: uppercase;
}

@media (max-width: 1024px) {
  .feature-makeup {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto auto auto;
    gap: 0;
    align-items: start;
  }

  .feature-makeup .feature-eyebrow-top {
    grid-column: 1;
    grid-row: 1;
    margin: 0 0 14px;
  }

  .feature-makeup .feature-image {
    grid-column: 1;
    grid-row: 2;
    width: 100%;
    margin: 0 0 28px;
  }

  .feature-makeup .feature-copy {
    grid-column: 1;
    grid-row: 3;
    width: 100%;
    max-width: none;
  }

  .feature-makeup .feature-mini-grid {
    width: 100%;
    margin-top: 24px;
  }
}

@media (max-width: 560px) {
  .feature-makeup .feature-eyebrow-top { margin-bottom: 13px; }
  .feature-makeup .feature-mini-grid { margin-top: 22px; }
  .feature-makeup .feature-mini-grid span { padding: 12px 6px 11px; }
  .feature-makeup .feature-mini-grid b { font-size: 10px; }
}

/* V34 — formação alinhada ao padrão editorial do restante da página */
.training {
  background: var(--cream);
  color: var(--ink);
  display: grid;
  grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
  gap: clamp(28px, 5vw, 76px);
  align-items: stretch;
}

.training-art {
  position: relative;
  min-height: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  overflow: visible;
}

.training-art-head {
  position: relative;
  z-index: 2;
  display: grid;
  gap: 12px;
  width: 100%;
  justify-items: start;
  align-items: start;
  text-align: left;
  margin-bottom: 16px;
}

.training-art-head .section-label,
.training-art-head .eyebrow {
  justify-self: start;
}

.training-art-head .section-label {
  color: var(--muted);
}

.training-art-head .eyebrow {
  color: var(--blue-deep);
  font-size: 9px;
}

.training-photo-wrap {
  position: relative;
  width: 100%;
  max-width: 520px;
  aspect-ratio: 1.08 / 1;
  align-self: center;
  border: 1px solid rgba(183,151,99,.28);
  border-radius: 30px;
  overflow: hidden;
  background: var(--cream-2);
  box-shadow: 0 18px 45px rgba(57,38,25,.07);
}

.training-photo-wrap::before {
  content: "";
  position: absolute;
  inset: 10px;
  border: 1px solid rgba(183,151,99,.18);
  border-radius: 22px;
  pointer-events: none;
  z-index: 2;
}

.training-photo-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.training-photo-caption {
  position: absolute;
  left: 18px;
  bottom: 18px;
  z-index: 3;
  padding: 8px 11px;
  border: 1px solid rgba(247,241,234,.5);
  border-radius: 999px;
  background: rgba(33,29,27,.56);
  color: #fff;
  font-size: 8px;
  text-transform: uppercase;
  letter-spacing: .13em;
  backdrop-filter: blur(8px);
}

.training-photo-caption em {
  color: #f1d8a2;
  font-style: normal;
}

.training-copy {
  position: relative;
  overflow: hidden;
  border-radius: 28px;
  padding: clamp(30px, 4vw, 46px);
  background: linear-gradient(145deg, #0b5579 0%, var(--blue-deep) 70%, #083d5f 100%);
  color: #fff;
  box-shadow: 0 22px 55px rgba(0,45,74,.13);
}

.training-copy::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, rgba(231,199,146,.72), rgba(231,199,146,.08), transparent 78%);
}

.training-copy::after {
  content: "DO";
  position: absolute;
  right: -18px;
  bottom: -44px;
  font-family: var(--serif);
  font-size: 150px;
  line-height: .8;
  color: rgba(183,151,99,.05);
  pointer-events: none;
}

.training-copy > * { position: relative; z-index: 1; }
.training-copy .eyebrow-training-light { color: #e8d1a5; }
.training-copy .eyebrow-training-light i { background: currentColor; }
.training-copy h2 { margin-top: 22px; color: #fff; }
.training-copy h2 em { color: #e5c995; }
.training-copy p { color: rgba(255,255,255,.76); max-width: 570px; }

.training-points {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  margin: 30px 0 28px;
  border-top: 1px solid rgba(231,199,146,.25);
  border-bottom: 1px solid rgba(231,199,146,.22);
}

.training-points span {
  padding: 13px 12px;
  font-size: 10px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: .12em;
  color: rgba(255,255,255,.8);
  text-align: center;
}

.training-points span + span {
  border-left: 1px solid rgba(231,199,146,.2);
}

.btn-training {
  background: #f7f1ea;
  color: var(--blue-deep);
  border: 1px solid rgba(247,241,234,.55);
}

.btn-training:hover {
  background: #fff;
  color: var(--blue-deep);
}

.btn-training .whatsapp-icon {
  width: 18px;
  height: 18px;
  color: var(--blue-deep);
}

.note {
  color: rgba(255,255,255,.46);
}

.training-number,
.training-word,
.training-card {
  display: none;
}

@media (max-width: 820px) {
  .training {
    grid-template-columns: 1fr;
    gap: 16px;
    padding-top: 62px;
    padding-bottom: 62px;
  }

  .training-art {
    padding: 0;
  }

  .training-art-head {
    margin-bottom: 14px;
  }

  .training-photo-wrap {
    width: 100%;
    max-width: none;
    aspect-ratio: 1.12 / 1;
    border-radius: 24px;
  }

  .training-photo-wrap::before {
    inset: 8px;
    border-radius: 18px;
  }

  .training-photo-caption {
    left: 14px;
    bottom: 14px;
  }

  .training-copy {
    border-radius: 24px;
    padding: 30px 22px 34px;
    box-shadow: 0 18px 42px rgba(0,45,74,.12);
  }

  .training-copy h2 {
    font-size: clamp(44px, 12vw, 64px);
  }

  .training-points {
    margin-top: 24px;
  }

  .training-points span {
    padding: 12px 8px;
    font-size: 9px;
  }

  .btn-training {
    min-height: 48px;
  }
}


/* V38 — resultados por categoria com carrossel horizontal */
.results-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 30px;
}
.results-title-block { max-width: 760px; }
.results-title-block h2 { margin-top: 18px; }
.results-instagram { margin-bottom: 6px; }

.results-tabs {
  display: inline-flex;
  gap: 0;
  margin-top: 48px;
  padding: 4px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: rgba(255,255,255,.35);
}
.results-tab {
  appearance: none;
  border: 0;
  background: transparent;
  color: var(--muted);
  font-family: var(--sans);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .12em;
  text-transform: uppercase;
  padding: 11px 16px;
  border-radius: 999px;
  cursor: pointer;
  transition: .25s ease;
}
.results-tab.is-active {
  background: var(--blue-deep);
  color: #fff;
}
.results-tab:focus-visible {
  outline: 2px solid var(--gold);
  outline-offset: 2px;
}

.results-panel { margin-top: 24px; }
.results-panel[hidden] { display: none; }
.results-carousel {
  display: flex;
  gap: 14px;
  overflow-x: auto;
  padding: 2px 2px 18px;
  scroll-snap-type: x mandatory;
  scrollbar-width: thin;
  scrollbar-color: rgba(166,126,61,.35) transparent;
}
.results-carousel::-webkit-scrollbar { height: 5px; }
.results-carousel::-webkit-scrollbar-track { background: transparent; }
.results-carousel::-webkit-scrollbar-thumb { background: rgba(166,126,61,.35); border-radius: 999px; }
.results-slide {
  flex: 0 0 min(32vw, 360px);
  margin: 0;
  scroll-snap-align: start;
  border: 1px solid var(--line);
  border-radius: 26px;
  overflow: hidden;
  background: var(--paper);
}
.results-slide-featured { flex-basis: min(42vw, 500px); }
.results-slide img {
  width: 100%;
  aspect-ratio: 1 / .88;
  object-fit: cover;
  display: block;
}
.results-slide figcaption {
  display: grid;
  gap: 6px;
  padding: 15px 16px 18px;
}
.results-slide figcaption span {
  color: var(--gold);
  font-size: 8px;
  font-weight: 600;
  letter-spacing: .16em;
  text-transform: uppercase;
}
.results-slide figcaption strong {
  font-family: var(--serif);
  font-size: 20px;
  line-height: 1;
  font-weight: 500;
  color: var(--ink);
}

@media (max-width: 820px) {
  .results-head { flex-direction: column; align-items: flex-start; }
  .results-instagram { margin-top: 4px; }
  .results-tabs { margin-top: 30px; max-width: 100%; overflow-x: auto; }
  .results-tab { padding: 10px 13px; white-space: nowrap; font-size: 9px; }
}

@media (max-width: 560px) {
  .results-head { gap: 18px; }
  .results-title-block h2 { margin-top: 12px; }
  .results-tabs { width: 100%; justify-content: space-between; }
  .results-tab { flex: 1 1 auto; padding: 10px 8px; font-size: 8px; letter-spacing: .09em; }
  .results-panel { margin-top: 20px; }
  .results-carousel { gap: 10px; padding-bottom: 14px; margin-right: -18px; padding-right: 18px; }
  .results-slide, .results-slide-featured { flex-basis: 84%; }
  .results-slide img { aspect-ratio: 1 / .88; }
  .results-slide figcaption { padding: 13px 14px 16px; }
  .results-slide figcaption strong { font-size: 19px; }
}

/* V39 — feedbacks em carrossel, seguindo a linguagem dos resultados */
.feedback { background: var(--paper); }
.feedback-head { margin-top: 30px; }
.feedback-head > div { max-width: 760px; }
.feedback-carousel { margin-top: 44px; }
.feedback-viewport { overflow: hidden; }
.feedback-track { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -ms-overflow-style: none; overscroll-behavior-x: contain; }
.feedback-track::-webkit-scrollbar { display: none; }
.feedback-track .quote-card { flex: 0 0 100%; width: 100%; min-width: 100%; scroll-snap-align: start; }
.quote-card { min-height: 330px; padding: 48px; border: 1px solid var(--line); border-radius: 28px; background: var(--cream); display: flex; flex-direction: column; justify-content: flex-start; }
.quote-mark { display: block; font-family: var(--serif); font-size: 80px; line-height: .5; color: var(--gold); }
.quote-card p { margin: 48px 0 28px; max-width: 760px; font-size: 34px; line-height: .98; }
.quote-card footer { margin-top: auto; color: var(--muted); font-size: 9px; letter-spacing: .12em; text-transform: uppercase; }
.feedback-controls { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-top: 18px; }
.feedback-dots { display: flex; align-items: center; gap: 7px; }
.feedback-dot { width: 7px; height: 7px; padding: 0; border: 1px solid var(--gold); border-radius: 50%; background: transparent; opacity: .55; cursor: pointer; }
.feedback-dot.is-active { width: 24px; border-radius: 20px; background: var(--gold); opacity: .85; }
.feedback-arrows { display: flex; gap: 8px; }
.feedback-arrow { width: 38px; height: 38px; border: 1px solid rgba(183,151,99,.34); border-radius: 50%; background: transparent; color: var(--ink); font-size: 16px; cursor: pointer; transition: background .2s ease, border-color .2s ease, transform .2s ease; }
.feedback-arrow:hover { background: rgba(183,151,99,.08); border-color: rgba(183,151,99,.55); transform: translateY(-1px); }

@media (min-width: 821px) {
  .feedback-head > div { max-width: 620px; }
  .feedback-track .quote-card { flex-basis: min(760px, 78%); min-width: min(760px, 78%); }
  .feedback-carousel { max-width: 980px; }
}

@media (max-width: 560px) {
  .feedback-head { margin-top: 24px; }
  .feedback-carousel { margin-top: 28px; }
  .quote-card { min-height: 285px; padding: 30px; border-radius: 24px; }
  .quote-mark { font-size: 66px; }
  .quote-card p { margin: 34px 0 24px; font-size: 28px; }
  .feedback-controls { margin-top: 14px; }
  .feedback-arrow { width: 36px; height: 36px; }
}
